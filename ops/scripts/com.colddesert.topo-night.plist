<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installeren: cp naar ~/Library/LaunchAgents/ en dan: launchctl load ~/Library/LaunchAgents/com.colddesert.topo-night.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.colddesert.topo-night</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/code/topo/ops/scripts/nightly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/topo-night.out</string>
  <key>StandardErrorPath</key><string>/tmp/topo-night.err</string>
</dict>
</plist>
